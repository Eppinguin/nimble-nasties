{
  "name": "nimble-nasties",
  "version": "1.9.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "fonts": "node --experimental-strip-types scripts/fonts.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test:rules",
    "test:rules": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/alegreya": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "lucide-preact": "1.57.0",
    "preact": "11.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "26.6.5",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "packageManager": "pnpm@12.13.0"
}
